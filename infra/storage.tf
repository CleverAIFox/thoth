# ★ **스키마는 코드가 정했다.** `cache.py` 와 `guard.py` 를 읽으면 나온다.
#
#   캐시   {h: sha256(원문), ko: 번역}
#   카운터 {h: "quota#2026-09", chars: N, expires_at: N}
#
#   정렬 키가 없고 파티션 키 `h` 하나다. 두 종류가 한 테이블에 사는 이유는
#   테이블이 둘이면 IAM 도 둘, 백업 판단도 둘이 되기 때문이다.

resource "aws_dynamodb_table" "translations" {
  name = "${local.name}-translations"

  # ★ **온디맨드에는 요청 무료분이 아예 없다**(DECISIONS §181). 저장 25GB 는 어느
  #   모드에서나 공짜지만 **요청 무료분 25 WCU/RCU 는 `PROVISIONED` 에만** 붙는다.
  #   179 는 월 $0.001 이라 「전환의 값어치가 측정 아래다」 라고 적었는데, 그 $0.001 은
  #   **영구히 깔린 바닥**이었다 — 「거의 0」 은 0 이 아니다.
  #
  # ★ **자동 확장을 안 붙인다.** 붙이면 25 를 넘겨 과금되고, 안 붙이면 넘칠 때
  #   **조른다**. 조름은 시간이고 과금은 돈이다 — 이 저장소는 시간 쪽으로 진다.
  #   `tools/cost_check.py` 의 `금지자원` 이 `aws_appautoscaling_*` 을 막는다.
  #
  # ★ **25 는 계정·리전 몫이고 테이블들이 나눠 쓴다.** 그래서 `용량흠` 은 테이블
  #   하나씩이 아니라 **합**을 센다 — 둘째 테이블이 붙는 순간 둘 다 25 면 조용하고
  #   청구서는 두 배다.
  # ★ **그 둘째 테이블은 안 붙는다**(DECISIONS §183). 「수집 적재지」 로 세워 둔
  #   자리였고, 재 보니 **주 35건**이라 적재지 자체가 필요 없었다 — 장부는
  #   브라우저 저장소에 있다. **합을 세는 가드는 그대로 둔다**: 근거가 「둘째가
  #   올 것」 이 아니라 **「25 가 계정 몫」** 이라 전제가 사라져도 성립한다.
  billing_mode   = "PROVISIONED"
  read_capacity  = 25
  write_capacity = 25

  hash_key = "h"

  attribute {
    name = "h"
    type = "S"
  }

  # ★ **TTL 속성이 `expires_at` 이고 캐시 항목에는 그것이 없다**.
  #   그래서 카운터만 다음 달 + 7일에 사라지고 번역은 영구히 남는다. 캐시를
  #   지우면 재번역이고 과금 엔진에서는 재과금이다(DECISIONS §5).
  #
  # ★ 이것을 빠뜨리면 지난 달 문자 카운터가 영원히 남는다.
  ttl {
    attribute_name = "expires_at"
    enabled        = true
  }

  # ★ **PITR 을 켜지 않는다.** 캐시는 다시 만들 수 있고 카운터는 한 달짜리다.
  #   복구할 값이 없는 곳에 저장 비용을 얹지 않는다.
  point_in_time_recovery {
    enabled = false
  }
}
