{
  "manifest_version": 3,
  "name": "Thoth — 영어 문제 한글 번역",
  "version": "0.1.0",
  "description": "영어 문제와 웹페이지 본문 아래에 한글 번역을 바로 붙여 줍니다. Udemy 연습 시험은 문제·보기·해설을 나눠 번역합니다.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "thoth — 번역 설정",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/Pretendard.subset.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
