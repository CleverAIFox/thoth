# 키 목록의 정본. 실제 값은 .env 에 둔다(커밋하지 않는다).
AWS_PROFILE=fox
AWS_REGION=ap-northeast-2

# echo | translate | llm   (PLAN §3 #37)
ENGINE=echo
# memory | ddb
CACHE=file
CACHE_TABLE=thoth-translations
TERMINOLOGY_NAME=

MAX_CHARS_PER_MONTH=2000000
MAX_TEXT_LEN=5000

# ENGINE=local · CACHE=file 일 때
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=exaone3.5:7.8b
CACHE_FILE=.cache/translations.json
