# 키 목록의 정본. 실제 값은 .env 에 둔다(커밋하지 않는다).
AWS_PROFILE=fox
AWS_REGION=ap-northeast-2

# echo | local | translate | bedrock | http
ENGINE=echo
# memory | file | ddb          file 은 로컬 개발, ddb 는 배포
CACHE=file
CACHE_TABLE=thoth-translations
TERMINOLOGY_NAME=

MAX_CHARS_PER_MONTH=2000000
MAX_TEXT_LEN=5000

# 워커 접근 토큰. 비우면 무인증이고 로컬 개발의 기본값이다.
# 배포(Function URL)에서는 반드시 채운다 — URL 만 알면 누구나 상한을 태운다.
# 확장 쪽은 chrome.storage.local 의 stToken 에 같은 값을 넣는다.
WORKER_TOKEN=

# ENGINE=local 일 때
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=exaone3.5:7.8b
# 한 요청의 상한. 실측 배치 최대가 335초였다.
OLLAMA_TIMEOUT=700

# ENGINE=bedrock 일 때. 리전을 AWS_REGION 과 따로 두는 이유는 모델마다 제공
# 리전이 다르기 때문이다. 모델 하나 때문에 캐시·카운터까지 옮기지 않는다.
BEDROCK_REGION=ap-northeast-2
BEDROCK_MODEL=apac.amazon.nova-lite-v1:0
BEDROCK_MAX_TOKENS=2048

# ENGINE=http 일 때. 자체 모델 서버(seshat)를 끼우는 자리다.
# 계약은 MASTER §7-4. 끼우기 전에 python3 tools/engine_conformance.py $HTTP_URL
HTTP_URL=http://127.0.0.1:8100
HTTP_MODEL=
HTTP_TOKEN=
HTTP_TIMEOUT=50

# CACHE=file 일 때. 캐시와 카운터는 따로 둔다 — 캐시를 지워도 월 사용량은 남아야 한다.
CACHE_FILE=.cache/translations.json
QUOTA_FILE=.cache/quota.json

# 경로. 기계마다 다르므로 스크립트에 박지 않는다.
THOTH_SSD_ROOT=/mnt/f/projects/thoth
THOTH_EXT_DEST=/mnt/f/projects/thoth/ext-build
# 확장의 기본 엔드포인트·토큰. sync_ext.sh 가 파생물에만 써 넣는다.
# 비우면 확장이 127.0.0.1 로 떨어지고 팝업에서 손으로 넣어야 한다.
# ★ WORKER_TOKEN 과 다른 값이다. 그쪽은 로컬 워커가 요구할 토큰이고
#   채우면 골든셋과 스모크가 401 을 받는다.
EXT_ENDPOINT=
EXT_TOKEN=
WIN_DOWNLOADS=/mnt/c/Users/Fox/Downloads
